{
  "manifest_version": 3,
  "name": "gemini-app-scaler",
  "version": "1.0.1",
  "description": "Adjusts Google Gemini width, reading density, and code wrapping.",
  "permissions": ["storage"],
  "host_permissions": ["*://gemini.google.com/*"],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://gemini.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}